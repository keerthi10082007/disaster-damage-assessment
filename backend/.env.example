# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Copernicus Data Space Ecosystem
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret
SENTINEL_HUB_PROCESS_API_URL=https://services.sentinel-hub.com/api/v1/process

# Image Detector
IMAGE_DETECTOR_PROVIDER=roboflow
IMAGE_DETECTOR_API_URL=https://api.roboflow.com
IMAGE_DETECTOR_API_KEY=your_detector_api_key
IMAGE_DETECTOR_MODEL=your_model_name
IMAGE_DETECTOR_VERSION=1

# Damage Assessment Model
DAMAGE_API_URL=https://your-damage-model-endpoint
DAMAGE_API_KEY=your_damage_api_key
DAMAGE_MODEL=damage-assessment-v1

# NASA Earth Imagery
NASA_API_KEY=your_nasa_api_key
NASA_EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3

# Application
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
ENVIRONMENT=development
DEBUG=true

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_EXPIRY_SECONDS=3600
